/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    // Test-only: referenced solely by the unit-test target's setupFiles in
    // angular.json, never imported by the app. It was type-checked here anyway,
    // so registering a Vitest hook in it broke `ng build` while `ng test` stayed
    // green — a split the CI job only catches at the build step.
    "src/test-setup.ts"
  ]
}
